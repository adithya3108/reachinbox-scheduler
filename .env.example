# --- Database ---
# DIRECT_URL is used by `prisma migrate`; DATABASE_URL is used by the app at
# runtime. For a plain (non-pooled) Postgres instance, set both the same.
# On Supabase: DATABASE_URL = the pooled connection string (port 6543),
# DIRECT_URL = the direct connection string (port 5432).
DATABASE_URL="postgresql://reachinbox:reachinbox@localhost:5433/reachinbox?schema=public"
DIRECT_URL="postgresql://reachinbox:reachinbox@localhost:5433/reachinbox?schema=public"

# --- Redis ---
REDIS_URL="redis://localhost:6379"

# --- Server ---
PORT=4000
FRONTEND_URL="http://localhost:5173"
SESSION_SECRET="change-me-to-a-long-random-string"
# Only set true once served over HTTPS -- browsers drop Secure cookies over
# plain HTTP, which would otherwise silently break login.
COOKIE_SECURE=false

# --- Google OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL="http://localhost:4000/api/auth/google/callback"

# --- Ethereal SMTP (create at https://ethereal.email) ---
ETHEREAL_HOST="smtp.ethereal.email"
ETHEREAL_PORT=587
ETHEREAL_USER=
ETHEREAL_PASSWORD=

# --- Worker / Scheduling ---
WORKER_CONCURRENCY=5
MIN_DELAY_MS=2000
MAX_EMAILS_PER_HOUR=100
